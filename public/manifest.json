{
  "manifest_version": 3,
  "name": "__MSG_name__",
  "short_name": "AgentSide",
  "version": "1.0.0",
  "description": "__MSG_description__",
  "default_locale": "en",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "sidePanel",
    "nativeMessaging",
    "storage"
  ],
  "action": {
    "default_title": "__MSG_action__",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}