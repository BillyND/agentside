{
  "name": "agentdock",
  "version": "1.0.0",
  "description": "Chat with local coding agents (Claude Code, Codex, OpenCode, Gemini CLI, any ACP agent) in a Chrome side panel",
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "setup": "npm run build && node host/install.mjs",
    "uninstall": "node host/install.mjs uninstall",
    "smoke": "node scripts/smoke-daemon.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.325",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "dompurify": "^3.4.18",
    "highlight.js": "^11.12.0",
    "marked": "^18.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.1.0"
  },
  "private": true,
  "type": "module",
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/chrome": "^0.3.7",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
